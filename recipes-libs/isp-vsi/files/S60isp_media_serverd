#!/bin/sh
#
# ISP Media Server Daemon
# Start/stop the ISP media server daemon
#

DAEMON="isp_media_serverd.sh"
DAEMON_PATH="/usr/bin"
PIDFILE="/var/run/isp_media_serverd.pid"

start() {
    echo "Starting ISP Media Server: "
    if [ -f "$DAEMON_PATH/$DAEMON" ]; then
        $DAEMON_PATH/$DAEMON -c start
        echo "OK"
    else
        echo "FAIL - $DAEMON not found"
        exit 1
    fi
}

stop() {
    echo "Stopping ISP Media Server: "
    $DAEMON_PATH/$DAEMON -c stop
    echo "OK"
}

restart() {
    $DAEMON_PATH/$DAEMON -c restart
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
